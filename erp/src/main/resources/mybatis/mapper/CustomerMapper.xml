<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.SpringBoot.dao.CustomerImp">
 
 	<select id="select" resultType="com.SpringBoot.bean.Customer">
 		select * from bus_customer 
 		<where>
 			<if test="customername!=null">
 				and customername like '%${customername}%'
 			</if>
 			<if test="connectionpersion!=null">
 				and connectionpersion like '%${connectionpersion}%'
 			</if>
 			<if test="phone!=null">
 				and phone like '%${phone}%'
 			</if>
 		</where>
 		limit #{index},#{limit}
 	
 	</select>
 	
 	<select id="selectCount" resultType="java.lang.Integer">
 		select count(*) from bus_customer 
 		<where>
 			<if test="customername!=null">
 				and customername like '%${customername}%'
 			</if>
 			<if test="connectionpersion!=null">
 				and connectionpersion like '%${connectionpersion}%'
 			</if>
 			<if test="phone!=null">
 				and phone like '%${phone}%'
 			</if>
 		</where>
 	</select>
 		
 	<select id="selectName" resultType="com.SpringBoot.bean.Customer">
 		select * from bus_customer
 	</select>
 
 	<insert id="insert">
 		insert into bus_customer (customername,address,connectionpersion,phone,email)
 		values
 		(#{customername},#{address},#{connectionpersion},#{phone},#{email})
 	</insert>
 	
 	<update id="update">
 		update bus_customer set customername=#{customername},address=#{address},
 		connectionpersion=#{connectionpersion},phone=#{phone},email=#{email}
 		where id=#{id}
 	</update>
 	
 	<delete id="delete">
 		delete from bus_customer where id=#{id}
 	</delete>
 	
 </mapper>